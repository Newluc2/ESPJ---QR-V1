  "testScenarios": [
    {
      "name": "Arrivée - Sortie",
      "steps": [
        "Accédez à http://localhost:5173/scan?userId=1",
        "Cliquez sur VALIDER (enregistre l'arrivée)",
        "Attendez quelques secondes",
        "Cliquez sur VALIDER à nouveau (enregistre la sortie)"
      ],
      "expected": "Les deux pointages doivent apparaître dans le Google Sheet"
    },
    {
      "name": "Génération QR Code",
      "steps": [
        "Allez sur http://localhost:5173/admin/login",
        "Connectez-vous avec le mot de passe admin",
        "Cliquez sur 'Générer QR' pour un utilisateur",
        "Téléchargez le QR code"
      ],
      "expected": "Un fichier PNG du QR code est téléchargé"
    },
    {
      "name": "Ajouter un Utilisateur",
      "steps": [
        "Depuis le panel admin",
        "Cliquez 'Ajouter un Utilisateur'",
        "Remplissez le formulaire",
        "Cliquez 'Ajouter'"
      ],
      "expected": "L'utilisateur apparaît dans la liste et dans Google Sheets"
    }
  ],
  "apiTests": [
    {
      "name": "Get User",
      "method": "GET",
      "endpoint": "/api/users/1",
      "curl": "curl http://localhost:5000/api/users/1"
    },
    {
      "name": "Register Attendance",
      "method": "POST",
      "endpoint": "/api/attendance/register",
      "curl": "curl -X POST http://localhost:5000/api/attendance/register -H 'Content-Type: application/json' -d '{\"userId\": \"1\"}'"
    },
    {
      "name": "Admin Login",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "curl": "curl -X POST http://localhost:5000/api/auth/login -H 'Content-Type: application/json' -d '{\"password\": \"admin123\"}'"
    },
    {
      "name": "Get All Attendance Today",
      "method": "GET",
      "endpoint": "/api/admin/attendance/today",
      "curl": "curl -H 'Authorization: Bearer <token>' http://localhost:5000/api/admin/attendance/today"
    }
  ],
  "googleSheetsStructure": {
    "sheet1": {
      "name": "Utilisateurs",
